# CareerNova Server Configuration
PORT=5000

# Transactional Email Service Configuration (Nodemailer / SMTP)
# For Gmail: Use smtp.gmail.com, Port 587, and an App Password from Google Account Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="CareerNova Support <noreply@careernova.com>"
